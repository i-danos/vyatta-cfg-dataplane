prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib/x86_64-linux-gnu
includedir=${exec_prefix}/include

Name: vplaned-client
Description: vplaned client library
Version: 1.0.0
Requires: libzmq, protobuf, vyatta-dataplane-proto, vyatta-controller-proto
Libs: -L${libdir} -lvplaned-client
Cflags: -I${includedir}
